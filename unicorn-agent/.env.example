# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic Claude API Key (or OpenAI, depending on provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database URL for PostgreSQL (isolated from main app)
DATABASE_URL=postgresql://user:password@localhost:5432/unicorn_agent_db
